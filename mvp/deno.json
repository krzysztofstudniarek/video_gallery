{
  "imports": {
    "@supabase/supabase-js": "npm:@supabase/supabase-js@2.118.0"
  },
  "compilerOptions": {
    "lib": [
      "deno.ns",
      "dom",
      "esnext"
    ]
  },
  "lock": {
    "path": "deno.lock",
    "frozen": true
  },
  "fmt": {
    "lineWidth": 100,
    "include": [
      "frontend/",
      "supabase/functions/",
      "tests/",
      "scripts/",
      "deno.json",
      "package.json",
      "tsconfig.json",
      "index.html"
    ]
  },
  "lint": {
    "exclude": [
      "frontend/database.types.ts"
    ],
    "rules": {
      "exclude": [
        "no-import-prefix",
        "require-await"
      ]
    }
  }
}
