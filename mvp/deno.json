{
  "imports": {
    "@supabase/supabase-js": "npm:@supabase/supabase-js@2.118.0"
  },
  "compilerOptions": {
    "lib": [
      "deno.ns",
      "dom",
      "esnext"
    ]
  },
  "lock": {
    "path": "deno.lock",
    "frozen": true
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "useTabs": false,
    "singleQuote": false,
    "semiColons": true,
    "proseWrap": "always",
    "include": [
      "frontend/",
      "supabase/functions/",
      "tests/",
      "scripts/",
      "deno.json",
      "package.json",
      "tsconfig.json",
      "index.html"
    ]
  },
  "lint": {
    "include": [
      "frontend/",
      "supabase/functions/",
      "tests/",
      "scripts/"
    ],
    "exclude": [
      "frontend/database.types.ts"
    ],
    "rules": {
      "tags": [
        "recommended",
        "react"
      ],
      "include": [
        "eqeqeq",
        "no-throw-literal"
      ],
      "exclude": [
        "require-await"
      ]
    }
  }
}
