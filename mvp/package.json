{
  "name": "videoalbum-mvp",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "supabase start",
    "reset": "supabase db reset --local",
    "serve": "supabase functions serve --env-file supabase/.env.local",
    "test:db": "supabase test db",
    "test:local": "node tests/local.mjs",
    "stop": "supabase stop",
    "test": "node --test scripts/*.test.mjs && deno test --allow-env tests",
    "check": "deno check supabase/functions/compatibility/index.ts supabase/functions/share/index.ts supabase/functions/health/index.ts supabase/functions/youtube/index.ts && tsc --noEmit",
    "deploy:backend": "node scripts/deploy.mjs",
    "smoke:staging": "node scripts/smoke.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "lint:fix": "deno lint --fix",
    "style:check": "npm run fmt:check && npm run lint",
    "hooks:install": "git config --local core.hooksPath .githooks",
    "types:db": "node scripts/database-types.mjs",
    "types:db:check": "node scripts/database-types.mjs --check"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "deno": "2.9.6",
    "supabase": "2.121.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
